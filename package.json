{
  "name": "ccollins-civiscribe-frontend",
  "private": true,
  "version": "2.0.10",
  "type": "module",
  "engines": {
    "node": "^24.22.2 || >=26.12.1"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "format:check": "prettier --check \".oxlintrc.json\" \"web/src/**/*.ts\" \"tests/frontend/**/*.mjs\" \"tests/e2e/**/*.mjs\" \"tests/fixtures/frontend-lint/*.json\" \"*.json\" \"*.mjs\"",
    "lint": "oxlint --deny-warnings web/src tests/frontend tests/e2e",
    "test": "npm run build && node --test tests/frontend/*.test.mjs",
    "test:e2e": "playwright test",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "oxlint": "1.93.0",
    "oxlint-tsgolint": "7.0.2007",
    "prettier": "^3.10.1",
    "typescript": "7.0.2"
  }
}
