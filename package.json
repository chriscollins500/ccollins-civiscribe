{
  "name": "ccollins-civiscribe-frontend",
  "private": true,
  "version": "2.0.10",
  "type": "module",
  "overrides": {
    "@typescript-eslint/typescript-estree@8.72.2": {
      "minimatch": "11.0.8"
    }
  },
  "engines": {
    "node": "^24.22.2 || >=26.12.1"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "format:check": "prettier --check \"web/src/**/*.ts\" \"tests/frontend/**/*.mjs\" \"tests/e2e/**/*.mjs\" \"*.json\" \"*.mjs\"",
    "lint": "eslint web/src tests/frontend tests/e2e",
    "test": "npm run build && node --test tests/frontend/*.test.mjs",
    "test:e2e": "playwright test",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
