{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/comfyui-civitai-save-node/comfyui-civitai-save-node/schemas/comfyui-civitai-save-node-sidecar.schema.json",
  "title": "ComfyUI Civitai Save Node Sidecar",
  "description": "Diagnostic JSON sidecar emitted by comfyui-civitai-save-node.",
  "type": "object",
  "required": [
    "sidecarFormat",
    "sidecarSchemaVersion",
    "generator",
    "image",
    "pngMetadata",
    "civitai",
    "resourceLifecycle",
    "warnings",
    "errors",
    "privacy"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri"
    },
    "sidecarFormat": {
      "const": "comfyui-civitai-save-node.sidecar"
    },
    "sidecarSchemaVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "generator": {
      "type": "object",
      "required": ["name", "package", "version"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "package": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "image": {
      "type": "object",
      "required": ["fileName", "format"],
      "properties": {
        "fileName": {"type": "string", "minLength": 1},
        "format": {"type": "string", "minLength": 1},
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1},
        "mode": {"type": "string"},
        "relativeSubfolder": {"type": "string"}
      },
      "additionalProperties": true
    },
    "pngMetadata": {
      "type": "object",
      "required": ["chunks", "compatibility"],
      "properties": {
        "chunks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["type", "keyword", "encoding", "compressed"],
            "properties": {
              "type": {"enum": ["tEXt", "iTXt", "zTXt", "eXIf"]},
              "keyword": {"type": "string", "minLength": 1},
              "encoding": {"type": "string", "minLength": 1},
              "compressed": {"type": "boolean"}
            },
            "additionalProperties": true
          }
        },
        "compatibility": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "a1111": {
      "type": "object",
      "properties": {
        "parameters": {"type": "string"},
        "unicodeFallbackApplied": {"type": "boolean"},
        "compatibilityTarget": {"type": "string"}
      },
      "additionalProperties": true
    },
    "civitai": {
      "type": "object",
      "additionalProperties": true
    },
    "resources": {
      "type": "object",
      "properties": {
        "resolved": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
        "unresolved": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
        "final": {"type": "array", "items": {"type": "object", "additionalProperties": true}}
      },
      "additionalProperties": true
    },
    "resourceLifecycle": {
      "type": "object",
      "required": [
        "rawResourcesFound",
        "activeResources",
        "normalizedResources",
        "resolvedResources",
        "unresolvedResources",
        "finalResources"
      ],
      "properties": {
        "rawResourcesFound": {"type": "array"},
        "activeResources": {"type": "array"},
        "normalizedResources": {"type": "array"},
        "resolvedResources": {"type": "array"},
        "unresolvedResources": {"type": "array"},
        "finalResources": {"type": "array"},
        "metadataStatus": {"type": "string"}
      },
      "additionalProperties": true
    },
    "lookupDiagnostics": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "client": {"type": ["string", "null"]},
        "sslContextSource": {"type": ["string", "null"]},
        "entries": {"type": "array", "items": {"type": "object", "additionalProperties": true}}
      },
      "additionalProperties": true
    },
    "settings": {
      "type": "object",
      "additionalProperties": true
    },
    "warnings": {
      "type": "array",
      "items": {"$ref": "#/$defs/issue"}
    },
    "errors": {
      "type": "array",
      "items": {"$ref": "#/$defs/issue"}
    },
    "privacy": {
      "type": "object",
      "required": [
        "absolutePathsIncluded",
        "tokensIncluded",
        "promptsSentToCivitai",
        "workflowSentToCivitai",
        "imagesSentToCivitai",
        "lookupRequestData"
      ],
      "properties": {
        "absolutePathsIncluded": {"type": "boolean"},
        "tokensIncluded": {"type": "boolean"},
        "promptsSentToCivitai": {"type": "boolean"},
        "workflowSentToCivitai": {"type": "boolean"},
        "imagesSentToCivitai": {"type": "boolean"},
        "lookupRequestData": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "legacy": {
      "type": "object",
      "additionalProperties": true
    },
    "extensions": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "additionalProperties": true,
  "$defs": {
    "issue": {
      "type": "object",
      "required": ["code", "message", "severity"],
      "properties": {
        "code": {"type": "string"},
        "message": {"type": "string"},
        "severity": {"enum": ["info", "warning", "error"]},
        "path": {"type": "string"},
        "field": {"type": "string"}
      },
      "additionalProperties": true
    }
  }
}
