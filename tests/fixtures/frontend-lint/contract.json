  "cases": [
    {
      "rule": "@typescript-eslint/await-thenable",
      "language": "ts",
      "code": "export async function probe() { await 42; }",
      "diagnostic": "typescript(await-thenable)"
    },
    {
      "rule": "@typescript-eslint/no-array-delete",
      "language": "ts",
      "code": "export function probe(values: string[]) { delete values[0]; }",
      "diagnostic": "typescript(no-array-delete)"
    },
    {
      "rule": "@typescript-eslint/no-base-to-string",
      "language": "ts",
      "code": "export const probe = String({ value: 1 });",
      "diagnostic": "typescript(no-base-to-string)"
    },
    {
      "rule": "@typescript-eslint/no-confusing-void-expression",
      "language": "ts",
      "code": "export function probe(callback: () => void) { return callback(); }",
      "diagnostic": "typescript(no-confusing-void-expression)"
    },
    {
      "rule": "@typescript-eslint/no-deprecated",
      "language": "ts",
      "code": "/** @deprecated Use replacement. */\nfunction obsolete() { return 1; }\nexport const probe = obsolete();",
      "diagnostic": "typescript(no-deprecated)"
    },
    {
      "rule": "@typescript-eslint/no-duplicate-type-constituents",
      "language": "ts",
      "code": "export type Probe = string | string;",
      "diagnostic": "typescript(no-duplicate-type-constituents)"
    },
    {
      "rule": "@typescript-eslint/no-floating-promises",
      "language": "ts",
      "code": "Promise.resolve('probe');",
      "diagnostic": "typescript(no-floating-promises)"
    },
    {
      "rule": "@typescript-eslint/no-for-in-array",
      "language": "ts",
      "code": "export function probe(values: string[]) { for (const key in values) { values[key]; } }",
      "diagnostic": "typescript(no-for-in-array)"
    },
    {
      "rule": "@typescript-eslint/no-generated-empty-object-type",
      "language": "ts",
      "code": "export type Probe = Omit<{ value: string }, 'value'>;",
      "diagnostic": "typescript(no-generated-empty-object-type)"
    },
    {
      "rule": "@typescript-eslint/no-implied-eval",
      "language": "ts",
      "code": "declare const code: string; setTimeout(code, 1);",
      "diagnostic": "typescript(no-implied-eval)"
    },
    {
      "rule": "@typescript-eslint/no-meaningless-void-operator",
      "language": "ts",
      "code": "export function probe(callback: () => void) { void callback(); }",
      "diagnostic": "typescript(no-meaningless-void-operator)"
    },
    {
      "rule": "@typescript-eslint/no-misused-promises",
      "language": "ts",
      "code": "export function probe(callback: () => Promise<void>) { if (callback()) { return 1; } return 0; }",
      "diagnostic": "typescript(no-misused-promises)"
    },
    {
      "rule": "@typescript-eslint/no-misused-spread",
      "language": "ts",
      "code": "export const probe = { ...Promise.resolve(1) };",
      "diagnostic": "typescript(no-misused-spread)"
    },
    {
      "rule": "@typescript-eslint/no-mixed-enums",
      "language": "ts",
      "code": "export enum Probe { A = 'a', B = 1 }",
      "diagnostic": "typescript(no-mixed-enums)"
    },
    {
      "rule": "@typescript-eslint/no-redundant-type-constituents",
      "language": "ts",
      "code": "export type Probe = string | unknown;",
      "diagnostic": "typescript(no-redundant-type-constituents)"
    },
    {
      "rule": "@typescript-eslint/no-unnecessary-boolean-literal-compare",
      "language": "ts",
      "code": "export function probe(value: boolean) { return value === true; }",
      "diagnostic": "typescript(no-unnecessary-boolean-literal-compare)"
    },
    {
      "rule": "@typescript-eslint/no-unnecessary-condition",
      "language": "ts",
      "code": "export function probe(value: string) { return value !== null; }",
      "diagnostic": "typescript(no-unnecessary-condition)"
    },
    {
      "rule": "@typescript-eslint/no-unnecessary-template-expression",
      "language": "ts",
      "code": "export function probe(value: string) { return `${value}`; }",
      "diagnostic": "typescript(no-unnecessary-template-expression)"
    },
    {
      "rule": "@typescript-eslint/no-unnecessary-type-arguments",
      "language": "ts",
      "code": "export type Box<T = string> = { value: T }; export type Probe = Box<string>;",
      "diagnostic": "typescript(no-unnecessary-type-arguments)"
    },
    {
      "rule": "@typescript-eslint/no-unnecessary-type-assertion",
      "language": "ts",
      "code": "export function probe(value: string) { return value as string; }",
      "diagnostic": "typescript(no-unnecessary-type-assertion)"
    },
    {
      "rule": "@typescript-eslint/no-unnecessary-type-conversion",
      "language": "ts",
      "code": "export function probe(value: string) { return String(value); }",
      "diagnostic": "typescript(no-unnecessary-type-conversion)"
    },
    {
      "rule": "@typescript-eslint/no-unnecessary-type-parameters",
      "language": "ts",
      "code": "export function probe<T>(value: T): void { console.log(value); }",
      "diagnostic": "typescript(no-unnecessary-type-parameters)"
    },
    {
      "rule": "@typescript-eslint/no-unsafe-argument",
      "language": "ts",
      "code": "export function probe(value: any) { return Math.max(value, 1); }",
      "diagnostic": "typescript(no-unsafe-argument)"
    },
    {
      "rule": "@typescript-eslint/no-unsafe-assignment",
      "language": "ts",
      "code": "export const probe: string = JSON.parse('\"x\"');",
      "diagnostic": "typescript(no-unsafe-assignment)"
    },
    {
      "rule": "@typescript-eslint/no-unsafe-call",
      "language": "ts",
      "code": "export function probe(value: any) { value(); }",
      "diagnostic": "typescript(no-unsafe-call)"
    },
    {
      "rule": "@typescript-eslint/no-unsafe-enum-assignment",
      "language": "ts",
      "code": "export enum Mode { A = 1 } export const probe: Mode = 1;",
      "diagnostic": "typescript(no-unsafe-enum-assignment)"
    },
    {
      "rule": "@typescript-eslint/no-unsafe-enum-comparison",
      "language": "ts",
      "code": "export enum Mode { A = 1 } export function probe(value: Mode) { return value === 1; }",
      "diagnostic": "typescript(no-unsafe-enum-comparison)"
    },
    {
      "rule": "@typescript-eslint/no-unsafe-member-access",
      "language": "ts",
      "code": "export function probe(value: any) { return value.field; }",
      "diagnostic": "typescript(no-unsafe-member-access)"
    },
    {
      "rule": "@typescript-eslint/no-unsafe-return",
      "language": "ts",
      "code": "export function probe(): string { return JSON.parse('\"x\"'); }",
      "diagnostic": "typescript(no-unsafe-return)"
    },
    {
      "rule": "@typescript-eslint/no-unsafe-unary-minus",
      "language": "ts",
      "code": "export function probe(value: string) { return -value; }",
      "diagnostic": "typescript(no-unsafe-unary-minus)"
    },
    {
      "rule": "@typescript-eslint/no-useless-default-assignment",
      "language": "ts",
      "code": "export function probe({ value = 'fallback' }: { value: string }) { return value; }",
      "diagnostic": "typescript(no-useless-default-assignment)"
    },
    {
      "rule": "@typescript-eslint/only-throw-error",
      "language": "ts",
      "code": "export function probe() { throw 'broken'; }",
      "diagnostic": "typescript(only-throw-error)"
    },
    {
      "rule": "@typescript-eslint/prefer-promise-reject-errors",
      "language": "ts",
      "code": "export const probe = Promise.reject('broken');",
      "diagnostic": "typescript(prefer-promise-reject-errors)"
    },
    {
